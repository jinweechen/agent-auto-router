{
  "schema": "agent-auto-router.quick-profiles",
  "defaultProfile": "standard",
  "profiles": {
    "safe": {
      "description": "Read-only inspection with no feedback persistence",
      "strategy": "balance",
      "sandbox": "read-only",
      "contextMode": "lean",
      "repositoryContextMode": "off",
      "modelAffinity": "off",
      "noFeedback": true
    },
    "standard": {
      "description": "Adaptive implementation planning limited to the selected workspace",
      "strategy": "balance",
      "sandbox": "workspace-write",
      "contextMode": "lean",
      "repositoryContextMode": "adaptive",
      "modelAffinity": "session",
      "noFeedback": true
    }
  }
}
